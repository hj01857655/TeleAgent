# TeleAgent2API — OpenAI-compatible proxy for TeleAgent

# === TeleAgent Auth Parameters (Required) ===
# 获取方式（三选一）：
#  ① 网页登录（推荐，可自动续期）：启动后打开 http://<服务器>:10000/ui ，
#     点击「网页登录续期」，用手机号/微信登录即可自动写入凭证，无需手动提取。
#  ② 一键提取脚本：在已登录桌面客户端的电脑上运行
#     powershell -ExecutionPolicy Bypass -File tools/get-teleagent-token.ps1
#  ③ 手动查找：新版客户端凭证目录（Windows）：
#     C:\Users\<你的用户名>\.local\share\TeleAgent\
#        ├─ app-auth\device-meta.json                                  ← deviceId / installId（明文）
#        └─ users\<用户ID>\app-auth\token.json                          ← token（DPAPI 加密，需脚本解密）
#     旧版路径 %APPDATA%\TeleAgent\app-auth\state.json 仍兼容（明文）。
# 注意：token 有效期约一个月；网页登录后会自动写入状态文件，重启仍然有效。
TELEAGENT_TOKEN=your_teleagent_jwt_token_here
TELEAGENT_INSTALL_ID=your_install_id_here
TELEAGENT_DEVICE_ID=your_device_id_here

# === Console Admin Password (控制台登录，与客户端密钥分离) ===
# 控制台 http://<host>:10000/ui 的登录密码。强烈建议设置独立强密码。
# 未设置时，控制台暂时沿用下面的 API_KEY（启动日志会告警）。
ADMIN_PASSWORD=admin-change-me

# === Client API Keys（客户端密钥）===
# 兼容用的单密钥：会被自动导入密钥库（可在「密钥」页看到并管理）。
# 建议在控制台「密钥」页为每个客户端创建独立密钥，然后把这里留空。
API_KEY=sk-custom-your-key

# === Rate Limit (protects the TeleAgent account quota) ===
# 每分钟允许的请求数（按 API Key 计）。API_KEY 一旦泄露，可防止被刷额度。
# 设为 0 关闭限流。注意：签到和聊天都走网关，会计入此限流。
# RATE_LIMIT_RPM=60

# === Server Configuration ===
TELEAGENT2API_LISTEN=:10000

# === Optional Overrides ===
# TELEAGENT_BASE_URL=https://agent.teleai.com.cn
# 上游应用标识（可选）。留空则不发送 Authorization 头——鉴权实际由
# TELEAGENT_TOKEN（X-Token）+ 设备头完成。如需固定该值，填写你自己的。
# TELEAGENT_UPSTREAM_KEY=
# TELEAGENT_ROUTE_TARGET=ops-gateway
# TELEAGENT_APP_VERSION=2.7.0
# TELEAGENT_MODELS=chat-nano,chat-lite,chat-pro,chat-flash
# TELEAGENT_TIMEOUT=120s
# TELEAGENT_LOG_LEVEL=info
# TELEAGENT_LOG_FORMAT=text
# TELEAGENT_RETRY_COUNT=0
# TELEAGENT_SIGN=0

# === Protocol Compatibility（OpenAI 客户端兼容层）===
# 上游是 TeleAgent 桌面端的自有后端，只认一小撮固定字段。Claude Code 等客户端
# 会带上 metadata / top_k / thinking / system 等字段，上游收到未知字段就整包拒绝，
# 返回「API 调用参数有误，请检查文档」。网关默认按白名单清洗请求，从源头消掉这个报错。

# <think> 推理块的去向（GLM 系上游把思维链放在 content 开头）：
#   content           原样透传，保留 <think> 标签（默认，唯一不会让回复变差的模式）
#   reasoning_content 拆到 delta.reasoning_content，content 保持干净（推荐给支持推理通道的客户端）
#   visible           去掉标签但保留文字，留在 content 里（没有推理通道的客户端用来显示进度）
#   strip             整个丢弃推理块
# TELEAGENT_REASONING_MODE=content

# 白名单之外再额外放行的字段，逗号分隔。仅在上游确实接受该字段时使用，
# 否则又回到「API 调用参数有误」。
# TELEAGENT_EXTRA_FIELDS=reasoning_effort

# 每个模型的 max_tokens 上限，JSON 对象（不是 CSV）。超出的请求会被截到上限；
# 未列出的模型不设上限。默认值：
#   {"chat-nano":16384,"chat-lite":32768,"chat-pro":65536,"chat-flash":65536}
# TELEAGENT_MODEL_LIMITS={"chat-pro":65536}

# === Auto Check-in (TeleAgent 积分福利社 / Star Welfare Club) ===
# 每天定时调用积分福利社的每日签到接口（type=daily_login）。
# 生效后仍可用 POST /v1/checkin 手动触发，GET /v1/checkin 查看状态。
# CHECKIN_ENABLED=1
# CHECKIN_TIME=08:00              # 每天签到时间（Asia/Shanghai 时区）
# CHECKIN_TYPE=daily_login        # 任务类型：daily_login / first_login / monthly_basic
# TELEAGENT_USER_ID=              # 可选：福利社门户的 userId 请求头（一般无需填写）

# === Upstream Egress Proxy (Resin-style proxy pool gateway) ===
# 让网关到 agent.teleai.com.cn 的上游流量走 Resin 代理池
# （https://github.com/Resinat/Resin）。支持 http/https/socks5。
# 身份采用 Resin 的 "Platform.Account:token" 约定，可写在 URL 里：
#   TELEAGENT_PROXY=http://Default.user_tom:my-token@127.0.0.1:2260
# 也可以拆开配置（自动拼接为 Platform.Account）：
#   TELEAGENT_PROXY=http://127.0.0.1:2260
#   TELEAGENT_PROXY_PLATFORM=Default     # Resin 平台（节点池）
#   TELEAGENT_PROXY_ACCOUNT=user_tom     # 业务账号（同一账号粘性同一出口 IP）
#   TELEAGENT_PROXY_TOKEN=my-token       # RESIN_PROXY_TOKEN

# === Web Login / Token Renewal ===
# 网页登录续期：打开 /ui 点击「网页登录续期」，登录后新 token 自动写入状态文件并立即生效。
# TELEAGENT_STATE_FILE=/app/data/token-state.json   # 凭证状态文件（docker-compose 已挂载 ./data）
# TELEAGENT_PUBLIC_URL=https://your-domain.com      # 网关在反向代理后时填写，用于拼接登录回调地址

# === Persistent State Files（控制台管理的运行时数据）===
# 多账号池与客户端密钥库由控制台维护，需持久化到卷中（docker-compose 已挂载 ./data）。
# TELEAGENT_ACCOUNTS_FILE=/app/data/teleagent-accounts.json   # 多账号池
# TELEAGENT_KEYS_FILE=/app/data/teleagent-keys.json           # 客户端密钥库

